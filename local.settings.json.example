{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "ADX_CLUSTER_URI": "https://<cluster>.kusto.windows.net",
    "ADX_DATABASE": "vrtxsentinel",
    "KEYVAULT_URI": "https://<vault>.vault.azure.net/",
    "KEYVAULT_ADX_APP_ID_SECRET_NAME": "adx-app-id",
    "KEYVAULT_ADX_APP_KEY_SECRET_NAME": "adx-app-key",
    "EVENTGRID_TOPIC_ENDPOINT": "https://<topic>.<region>-1.eventgrid.azure.net/api/events",
    "KEYVAULT_EVENTGRID_TOPIC_KEY_SECRET_NAME": "eventgrid-topic-key",
    "AZURE_OPENAI_ENDPOINT": "https://<resource>.openai.azure.com",
    "AZURE_OPENAI_DEPLOYMENT": "gpt-4o",
    "AZURE_OPENAI_API_VERSION": "2024-12-01-preview",
    "KEYVAULT_OPENAI_KEY_SECRET_NAME": "openai-key",
    "JWT_AUDIENCE": "vrtx-sentinel-api",
    "JWT_ISSUER": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "JWT_HS256_SECRET": "change-this-secret"
  }
}
